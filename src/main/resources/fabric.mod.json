{
	"schemaVersion": 1,
	"id": "emerald-tools",
	"version": "${version}",
	"name": "emerald-tools",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/emerald-tools/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.emeraldtools.EmeraldTools"
		],
		"client": [
			"com.emeraldtools.client.EmeraldToolsClient"
		],
		"fabric-datagen": [
			"com.emeraldtools.client.EmeraldToolsDataGenerator"
		]
	},
	"mixins": [
		"emerald-tools.mixins.json",
		{
			"config": "emerald-tools.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}