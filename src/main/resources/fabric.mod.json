{
	"schemaVersion": 1,
	"id": "emerald-tools",
	"version": "${version}",
	"name": "Emerald Tools",
	"description": "Emerald tools and armor. They hit harder, mine faster and protect better than diamond, but last half as long.",
	"authors": [
		"Hyrum66"
	],
	"contact": {
		"homepage": "https://github.com/HyrumMoses/emerald-tools",
		"sources": "https://github.com/HyrumMoses/emerald-tools"
	},
	"license": "CC0-1.0",
	"icon": "assets/emerald-tools/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.emeraldtools.EmeraldTools"
		],
		"client": [
			"com.emeraldtools.client.EmeraldToolsClient"
		],
		"fabric-datagen": [
			"com.emeraldtools.client.EmeraldToolsDataGenerator"
		]
	},
	"mixins": [
		"emerald-tools.mixins.json",
		{
			"config": "emerald-tools.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}